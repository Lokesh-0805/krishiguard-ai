# Copy to .env and adjust. Backend settings use the KG_ prefix (see backend/app/core/config.py).
POSTGRES_USER=krishiguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=krishiguard

KG_ENVIRONMENT=production
KG_LOG_LEVEL=INFO
KG_INFERENCE_THREADS=2
KG_MAX_UPLOAD_MB=8
KG_RATE_LIMIT_PREDICT=30/minute
KG_CORS_ORIGINS=["http://localhost:3000"]
# Composed automatically in docker-compose.yml from the POSTGRES_* values above. For local (non-Docker) runs:
# KG_DATABASE_URL=postgresql+psycopg://krishiguard:change-me@localhost:5432/krishiguard

# Frontend -> backend rewrite target (baked in at frontend build time)
BACKEND_URL=http://backend:8000
